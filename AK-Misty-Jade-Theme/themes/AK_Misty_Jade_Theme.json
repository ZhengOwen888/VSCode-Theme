{
  "$schema": "vscode://schemas/color-theme",
  "name": "AK Misty Jade Theme",
  "type": "dark",
  "colors": {
    "activityBar.background": "#101408",
    "activityBar.foreground": "#c8dfc0",
    "activityBar.border": "#1e2a12",
    "activityBarBadge.background": "#18d4b8",
    "activityBarBadge.foreground": "#0a0e06",
    "badge.background": "#18d4b8",
    "badge.foreground": "#0a0e06",
    "button.background": "#18d4b8",
    "button.foreground": "#0a0e06",
    "button.hoverBackground": "#30e0c4",
    "debugToolBar.background": "#101408",
    "debugToolBar.border": "#2a3818",
    "descriptionForeground": "#8aaa78",
    "dropdown.background": "#13180a",
    "dropdown.foreground": "#c8dfc0",
    "dropdown.border": "#2a3818",
    "editor.background": "#0c1008",
    "editor.foreground": "#c8dfc0",
    "editor.lineHighlightBackground": "#1a241080",
    "editor.lineHighlightBorder": "#26341480",
    "editor.selectionBackground": "#18d4b840",
    "editor.selectionHighlightBackground": "#18d4b820",
    "editor.findMatchBackground": "#c8b85860",
    "editor.findMatchHighlightBackground": "#c8b85830",
    "editor.rangeHighlightBackground": "#1a241099",
    "editorBracketHighlight.foreground1": "#c8b858",
    "editorBracketHighlight.foreground2": "#90c850",
    "editorBracketHighlight.foreground3": "#48b888",
    "editorBracketHighlight.foreground4": "#28b8b0",
    "editorBracketHighlight.foreground5": "#4898c8",
    "editorBracketHighlight.foreground6": "#7878c8",
    "editorBracketHighlight.unexpectedBracket.foreground": "#e04858",
    "editorCursor.foreground": "#18d4b8",
    "editorError.foreground": "#e04858",
    "editorGroup.border": "#1e2a12",
    "editorGroupHeader.tabsBackground": "#101408",
    "editorGroupHeader.tabsBorder": "#1e2a12",
    "editorGutter.addedBackground": "#48b888",
    "editorGutter.deletedBackground": "#e04858",
    "editorGutter.modifiedBackground": "#c8b858",
    "editorHoverWidget.background": "#101408",
    "editorHoverWidget.border": "#2a3818",
    "editorIndentGuide.background1": "#1a2410",
    "editorIndentGuide.activeBackground1": "#2e3e1c",
    "editorInfo.foreground": "#60a8d8",
    "editorLineNumber.foreground": "#2e4020",
    "editorLineNumber.activeForeground": "#6a8c58",
    "editorLink.activeForeground": "#18d4b8",
    "editorOverviewRuler.border": "#1e2a12",
    "editorOverviewRuler.modifiedForeground": "#c8b858",
    "editorOverviewRuler.addedForeground": "#48b888",
    "editorOverviewRuler.deletedForeground": "#e04858",
    "editorOverviewRuler.errorForeground": "#e04858",
    "editorOverviewRuler.warningForeground": "#d8c858",
    "editorSuggestWidget.background": "#101408",
    "editorSuggestWidget.border": "#2a3818",
    "editorSuggestWidget.highlightForeground": "#18d4b8",
    "editorSuggestWidget.selectedBackground": "#1a2410",
    "editorWarning.foreground": "#d8c858",
    "editorWhitespace.foreground": "#1e2a12",
    "editorWidget.background": "#101408",
    "editorWidget.border": "#2a3818",
    "focusBorder": "#18d4b8",
    "foreground": "#c8dfc0",
    "gitDecoration.addedResourceForeground": "#48b888",
    "gitDecoration.modifiedResourceForeground": "#c8b858",
    "gitDecoration.deletedResourceForeground": "#e04858",
    "gitDecoration.untrackedResourceForeground": "#7878c8",
    "gitDecoration.ignoredResourceForeground": "#3a5028",
    "input.background": "#13180a",
    "input.border": "#2a3818",
    "input.foreground": "#c8dfc0",
    "inputOption.activeBorder": "#18d4b8",
    "inputOption.activeBackground": "#18d4b820",
    "list.activeSelectionBackground": "#18d4b830",
    "list.activeSelectionForeground": "#18d4b8",
    "list.focusBackground": "#18d4b820",
    "list.highlightForeground": "#c8b858",
    "list.hoverBackground": "#1a241080",
    "list.inactiveSelectionBackground": "#1a241080",
    "menu.background": "#101408",
    "menu.foreground": "#c8dfc0",
    "menu.selectionBackground": "#18d4b830",
    "menu.border": "#1e2a12",
    "panel.background": "#13180a",
    "panel.border": "#1e2a12",
    "panelTitle.activeBorder": "#18d4b8",
    "panelTitle.activeForeground": "#18d4b8",
    "panelTitle.inactiveForeground": "#4a6838",
    "peekView.border": "#18d4b8",
    "peekViewEditor.background": "#13180a",
    "peekViewResult.background": "#101408",
    "peekViewTitle.background": "#080c06",
    "progressBar.background": "#18d4b8",
    "scrollbarSlider.background": "#2a381840",
    "scrollbarSlider.hoverBackground": "#2a381860",
    "scrollbarSlider.activeBackground": "#2a381880",
    "selection.background": "#18d4b850",
    "sideBar.background": "#13180a",
    "sideBar.border": "#1e2a12",
    "sideBar.foreground": "#c8dfc0",
    "sideBarSectionHeader.background": "#101408",
    "sideBarSectionHeader.foreground": "#c8dfc0",
    "sideBarSectionHeader.border": "#1e2a12",
    "sideBarTitle.foreground": "#8aaa78",
    "statusBar.background": "#080c06",
    "statusBar.foreground": "#c8dfc0",
    "statusBar.border": "#1e2a12",
    "statusBar.debuggingBackground": "#c43040",
    "statusBar.debuggingForeground": "#f0f0e8",
    "statusBarItem.remoteBackground": "#18d4b8",
    "statusBarItem.remoteForeground": "#0a0e06",
    "tab.activeBackground": "#0c1008",
    "tab.activeForeground": "#c8dfc0",
    "tab.activeBorder": "#18d4b8",
    "tab.activeBorderTop": "#18d4b830",
    "tab.border": "#1a2410",
    "tab.hoverBackground": "#1a241080",
    "tab.inactiveBackground": "#13180a",
    "tab.inactiveForeground": "#4a6838",
    "terminal.background": "#0c1008",
    "terminal.foreground": "#c8dfc0",
    "terminal.ansiBlack": "#0c1008",
    "terminal.ansiRed": "#c43040",
    "terminal.ansiGreen": "#48b888",
    "terminal.ansiYellow": "#c8b858",
    "terminal.ansiBlue": "#4898c8",
    "terminal.ansiMagenta": "#7878c8",
    "terminal.ansiCyan": "#18d4b8",
    "terminal.ansiWhite": "#c8dfc0",
    "terminal.ansiBrightBlack": "#3a5028",
    "terminal.ansiBrightRed": "#e04858",
    "terminal.ansiBrightGreen": "#90c850",
    "terminal.ansiBrightYellow": "#d8c858",
    "terminal.ansiBrightBlue": "#60a8d8",
    "terminal.ansiBrightMagenta": "#9898d8",
    "terminal.ansiBrightCyan": "#38e8c8",
    "terminal.ansiBrightWhite": "#e8f5e0",
    "terminal.selectionBackground": "#18d4b840",
    "terminalCursor.foreground": "#18d4b8",
    "titleBar.activeBackground": "#080c06",
    "titleBar.activeForeground": "#c8dfc0",
    "titleBar.border": "#1e2a12",
    "titleBar.inactiveBackground": "#101408",
    "titleBar.inactiveForeground": "#4a6838"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6a8c58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment - TODO/FIXME/NOTE",
      "scope": [
        "comment keyword.codetag",
        "comment.line keyword",
        "comment.block keyword"
      ],
      "settings": {
        "foreground": "#c8b858",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#c8dfc0"
      }
    },
    {
      "name": "Variable - Special/Constant",
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#7878c8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#e04858"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c43040",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#d04858",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keyword - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#a82838"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#d8c858"
      }
    },
    {
      "name": "Operator - Pointer/Reference (C/C++)",
      "scope": [
        "keyword.operator.address",
        "keyword.operator.dereference",
        "punctuation.separator.pointer-access"
      ],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.bracket", "meta.delimiter"],
      "settings": {
        "foreground": "#5a7848"
      }
    },
    {
      "name": "Punctuation - Namespace/Scope Separator",
      "scope": [
        "punctuation.separator.namespace",
        "punctuation.accessor",
        "punctuation.separator.scope-resolution"
      ],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": {
        "foreground": "#c43040"
      }
    },
    {
      "name": "HTML/XML Tag Name",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml"
      ],
      "settings": {
        "foreground": "#c43040"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#c8dfc0"
      }
    },
    {
      "name": "String - Template",
      "scope": ["string.template", "template.expression"],
      "settings": {
        "foreground": "#b0d0a8"
      }
    },
    {
      "name": "String - Escape",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#a8d858"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#a8d858",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Null / Undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#4a6838",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language Constants",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#a8d858"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#48c888"
      }
    },
    {
      "name": "Function - Built-in",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": {
        "foreground": "#60d898"
      }
    },
    {
      "name": "Class / Type",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#60a8d8"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#78b8e0"
      }
    },
    {
      "name": "Type Parameter/Generics",
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#90c8e8"
      }
    },
    {
      "name": "Namespace/Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "variable.other.readwrite.module"
      ],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#c8dfc0"
      }
    },
    {
      "name": "Property - Definition",
      "scope": ["entity.name.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#60a8d8"
      }
    },
    {
      "name": "Method - Class Member",
      "scope": ["entity.name.function.member", "meta.method.declaration"],
      "settings": {
        "foreground": "#48c888"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#d8c858"
      }
    },
    {
      "name": "Attribute - HTML",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#c8b858"
      }
    },
    {
      "name": "Attribute - ID",
      "scope": ["entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#e04858"
      }
    },
    {
      "name": "Attribute - Class",
      "scope": ["entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#7878c8"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name"
      ],
      "settings": {
        "foreground": "#60a8d8"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value.css", "constant.numeric.css"],
      "settings": {
        "foreground": "#a8d858"
      }
    },
    {
      "name": "CSS Class Selector",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#7878c8"
      }
    },
    {
      "name": "CSS ID Selector",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#e04858"
      }
    },
    {
      "name": "CSS Variable",
      "scope": ["variable.css", "variable.argument.css"],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "Decorator/Annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#c8b858",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python - Decorator @",
      "scope": ["punctuation.definition.decorator.python"],
      "settings": {
        "foreground": "#c8b858"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#18d4b8"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#60a8d8"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#48c888"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#a8d858"
      }
    },
    {
      "name": "JSON Key - Level 4+",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c8b858"
      }
    },
    {
      "name": "Python - Docstring",
      "scope": ["string.quoted.docstring.multi.python"],
      "settings": {
        "foreground": "#6a8c58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JavaScript/TypeScript - Arrow Function",
      "scope": [
        "storage.type.function.arrow.js",
        "storage.type.function.arrow.ts",
        "storage.type.function.arrow.tsx"
      ],
      "settings": {
        "foreground": "#d8c858"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#a8c898",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum Member / Variant",
      "scope": ["entity.name.type.enum", "variable.other.enummember"],
      "settings": {
        "foreground": "#7878c8"
      }
    },
    {
      "name": "Regex - Literal",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {
        "foreground": "#c43040"
      }
    },
    {
      "name": "Regex - Meta Group",
      "scope": ["punctuation.definition.group.regexp"],
      "settings": {
        "foreground": "#d8c858"
      }
    },
    {
      "name": "Rust - Lifetime",
      "scope": ["entity.name.lifetime.rust", "storage.modifier.lifetime.rust"],
      "settings": {
        "foreground": "#c43040",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust - Macro",
      "scope": ["entity.name.function.macro.rust", "support.function.macro.rust"],
      "settings": {
        "foreground": "#a8d858"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": ["markup.heading", "markup.heading.markdown"],
      "settings": {
        "foreground": "#18d4b8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#c8b858",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#7878c8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#6a8c58"
      }
    },
    {
      "name": "Markup - Link",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": {
        "foreground": "#60a8d8"
      }
    },
    {
      "name": "Markup - Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#48c888"
      }
    },
    {
      "name": "Git - Inserted",
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": {
        "foreground": "#48b888"
      }
    },
    {
      "name": "Git - Deleted",
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": {
        "foreground": "#e04858"
      }
    },
    {
      "name": "Git - Changed",
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": {
        "foreground": "#c8b858"
      }
    }
  ]
}