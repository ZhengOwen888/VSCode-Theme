{
  "$schema": "vscode://schemas/color-theme",
  "name": "Arknights Lightning Arts Theme",
  "type": "dark",
  "colors": {
    "activityBar.background": "#0c0e18",
    "activityBar.foreground": "#d8e8f5",
    "activityBar.border": "#1a2035",
    "activityBarBadge.background": "#00c8e8",
    "activityBarBadge.foreground": "#0c0e18",
    "badge.background": "#ffe060",
    "badge.foreground": "#0c0e18",
    "button.background": "#00c8e8",
    "button.foreground": "#0c0e18",
    "button.hoverBackground": "#40ddf5",
    "debugToolBar.background": "#0c0e18",
    "debugToolBar.border": "#2a4060",
    "descriptionForeground": "#8aaac8",
    "dropdown.background": "#111525",
    "dropdown.foreground": "#d8e8f5",
    "dropdown.border": "#253050",
    "editor.background": "#0a0d1a",
    "editor.foreground": "#d8e8f5",
    "editor.lineHighlightBackground": "#1a203880",
    "editor.lineHighlightBorder": "#2a406080",
    "editor.selectionBackground": "#00c8e855",
    "editor.selectionHighlightBackground": "#00c8e820",
    "editor.findMatchBackground": "#ffe06060",
    "editor.findMatchHighlightBackground": "#ffe06030",
    "editor.rangeHighlightBackground": "#1a203899",
    "editorBracketHighlight.foreground1": "#00c8e8",
    "editorBracketHighlight.foreground2": "#60e0ff",
    "editorBracketHighlight.foreground3": "#ffe060",
    "editorBracketHighlight.foreground4": "#a898ff",
    "editorBracketHighlight.foreground5": "#4a80ff",
    "editorBracketHighlight.foreground6": "#80d8ff",
    "editorCursor.foreground": "#ffe060",
    "editorError.foreground": "#ff7070",
    "editorGroup.border": "#1a2035",
    "editorGroupHeader.tabsBackground": "#0c0e18",
    "editorGroupHeader.tabsBorder": "#1a2035",
    "editorGutter.addedBackground": "#00c8e8",
    "editorGutter.deletedBackground": "#ff7070",
    "editorGutter.modifiedBackground": "#ffe060",
    "editorHoverWidget.background": "#0c0e18",
    "editorHoverWidget.border": "#2a4060",
    "editorIndentGuide.background1": "#1a1e30",
    "editorIndentGuide.activeBackground1": "#2a4060",
    "editorInfo.foreground": "#4a80ff",
    "editorLineNumber.foreground": "#3a5070",
    "editorLineNumber.activeForeground": "#00c8e8",
    "editorLink.activeForeground": "#60e0ff",
    "editorOverviewRuler.border": "#1a2035",
    "editorOverviewRuler.modifiedForeground": "#ffe060",
    "editorOverviewRuler.addedForeground": "#00c8e8",
    "editorOverviewRuler.deletedForeground": "#ff7070",
    "editorOverviewRuler.errorForeground": "#ff7070",
    "editorOverviewRuler.warningForeground": "#ffaa50",
    "editorSuggestWidget.background": "#0c0e18",
    "editorSuggestWidget.border": "#2a4060",
    "editorSuggestWidget.highlightForeground": "#60e0ff",
    "editorSuggestWidget.selectedBackground": "#1a2038",
    "editorWarning.foreground": "#ffaa50",
    "editorWhitespace.foreground": "#1a1e30",
    "editorWidget.background": "#0c0e18",
    "editorWidget.border": "#2a4060",
    "focusBorder": "#00c8e8",
    "foreground": "#d8e8f5",
    "gitDecoration.addedResourceForeground": "#00c8e8",
    "gitDecoration.modifiedResourceForeground": "#ffe060",
    "gitDecoration.deletedResourceForeground": "#ff7070",
    "gitDecoration.untrackedResourceForeground": "#a898ff",
    "gitDecoration.ignoredResourceForeground": "#3a4060",
    "input.background": "#111525",
    "input.border": "#253050",
    "input.foreground": "#d8e8f5",
    "inputOption.activeBorder": "#00c8e8",
    "inputOption.activeBackground": "#00c8e820",
    "list.activeSelectionBackground": "#00c8e830",
    "list.activeSelectionForeground": "#60e0ff",
    "list.focusBackground": "#00c8e820",
    "list.highlightForeground": "#ffe060",
    "list.hoverBackground": "#1a203880",
    "list.inactiveSelectionBackground": "#1a203880",
    "menu.background": "#0c0e18",
    "menu.foreground": "#d8e8f5",
    "menu.selectionBackground": "#00c8e830",
    "menu.border": "#1a2035",
    "panel.background": "#111525",
    "panel.border": "#1a2035",
    "panelTitle.activeBorder": "#00c8e8",
    "panelTitle.activeForeground": "#60e0ff",
    "panelTitle.inactiveForeground": "#4a6080",
    "peekView.border": "#00c8e8",
    "peekViewEditor.background": "#111525",
    "peekViewResult.background": "#0c0e18",
    "peekViewTitle.background": "#080a12",
    "progressBar.background": "#00c8e8",
    "scrollbarSlider.background": "#2a406040",
    "scrollbarSlider.hoverBackground": "#3a506060",
    "scrollbarSlider.activeBackground": "#00c8e830",
    "selection.background": "#00c8e840",
    "sideBar.background": "#111525",
    "sideBar.border": "#1a2035",
    "sideBar.foreground": "#d8e8f5",
    "sideBarSectionHeader.background": "#0c0e18",
    "sideBarSectionHeader.foreground": "#d8e8f5",
    "sideBarSectionHeader.border": "#1a2035",
    "sideBarTitle.foreground": "#8aaac8",
    "statusBar.background": "#001a2a",
    "statusBar.foreground": "#d8e8f5",
    "statusBar.border": "#1a2035",
    "statusBar.debuggingBackground": "#ff7070",
    "statusBar.debuggingForeground": "#0c0e18",
    "statusBarItem.remoteBackground": "#00c8e8",
    "statusBarItem.remoteForeground": "#0c0e18",
    "tab.activeBackground": "#0f1220",
    "tab.activeForeground": "#60e0ff",
    "tab.activeBorder": "#60e0ff",
    "tab.activeBorderTop": "#80d8ff",
    "tab.border": "#1a1e30",
    "tab.hoverBackground": "#1a203880",
    "tab.inactiveBackground": "#111525",
    "tab.inactiveForeground": "#4a6080",
    "terminal.background": "#0a0d1a",
    "terminal.foreground": "#d8e8f5",
    "terminal.ansiBlack": "#0a0d1a",
    "terminal.ansiRed": "#ff7070",
    "terminal.ansiGreen": "#00c8e8",
    "terminal.ansiYellow": "#ffe060",
    "terminal.ansiBlue": "#4a80ff",
    "terminal.ansiMagenta": "#a898ff",
    "terminal.ansiCyan": "#60e0ff",
    "terminal.ansiWhite": "#d8e8f5",
    "terminal.ansiBrightBlack": "#253050",
    "terminal.ansiBrightRed": "#ff9090",
    "terminal.ansiBrightGreen": "#40ddf5",
    "terminal.ansiBrightYellow": "#ffe88a",
    "terminal.ansiBrightBlue": "#7aabff",
    "terminal.ansiBrightMagenta": "#c0b0ff",
    "terminal.ansiBrightCyan": "#a0eeff",
    "terminal.ansiBrightWhite": "#eef5ff",
    "terminal.selectionBackground": "#00c8e840",
    "terminalCursor.foreground": "#ffe060",
    "titleBar.activeBackground": "#0c0e18",
    "titleBar.activeForeground": "#d8e8f5",
    "titleBar.border": "#1a2035",
    "titleBar.inactiveBackground": "#111525",
    "titleBar.inactiveForeground": "#4a6080"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a7898"
      }
    },
    {
      "name": "Comment - TODO/FIXME/NOTE",
      "scope": [
        "comment keyword.codetag",
        "comment.line keyword",
        "comment.block keyword"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#d8e8f5"
      }
    },
    {
      "name": "Variable - Special/Constant",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7070"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b8a8ff"
      }
    },
    {
      "name": "Keyword - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#c0b0ff"
      }
    },
    {
      "name": "Keyword - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#8878e8"
      }
    },
    {
      "name": "Import/Include - Package or Header Name",
      "scope": [
        "storage.modifier.import.java",
        "storage.modifier.package.java",
        "variable.language.wildcard.java",
        "meta.package.java entity.name.type",
        "meta.import.java entity.name.type",
        "meta.package.java storage.type",
        "meta.import.java storage.type",
        "meta.preprocessor.include",
        "string.quoted.other.lt-gt.include",
        "meta.preprocessor string.quoted",
        "meta.statement.import.python",
        "entity.name.type.module",
        "support.module",
        "meta.import entity.name.type",
        "meta.import entity.name.namespace"
      ],
      "settings": {
        "foreground": "#78eeff"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "Operator - Pointer/Reference (C/C++)",
      "scope": [
        "keyword.operator.address",
        "keyword.operator.dereference",
        "punctuation.separator.pointer-access"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#6080a0"
      }
    },
    {
      "name": "Punctuation - Namespace/Scope Separator",
      "scope": [
        "punctuation.separator.namespace",
        "punctuation.accessor",
        "punctuation.separator.scope-resolution"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "HTML/XML Tag Name",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml"
      ],
      "settings": {
        "foreground": "#00c8e8"
      }
    },
    {
      "name": "Tag - Self-closing Slash",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#4a80ff"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#70ddb5"
      }
    },
    {
      "name": "String - Escape Character",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00c8e8"
      }
    },
    {
      "name": "String - Template Expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#ffd030"
      }
    },
    {
      "name": "Boolean / Null / Undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "Built-in Constant",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "Function Name",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#ffc44d"
      }
    },
    {
      "name": "Function - Built-in / Library",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#ffd97a"
      }
    },
    {
      "name": "Function - Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#00deff"
      }
    },
    {
      "name": "Class / Type Name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#50f0cc"
      }
    },
    {
      "name": "Inherited Class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#78eeff"
      }
    },
    {
      "name": "Type Annotation",
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#70edc0"
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "Type Parameter/Generics",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#c0b0ff"
      }
    },
    {
      "name": "Namespace/Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "variable.other.readwrite.module"
      ],
      "settings": {
        "foreground": "#78eeff"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#d8e8f5"
      }
    },
    {
      "name": "Property - Definition",
      "scope": [
        "entity.name.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4a80ff"
      }
    },
    {
      "name": "Method - Class Member",
      "scope": [
        "entity.name.function.member",
        "meta.method.declaration"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "Attribute - HTML",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#ffe088"
      }
    },
    {
      "name": "Attribute - ID",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#ffa060"
      }
    },
    {
      "name": "Attribute - Class",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name"
      ],
      "settings": {
        "foreground": "#4a80ff"
      }
    },
    {
      "name": "CSS Value",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#80e8c0"
      }
    },
    {
      "name": "CSS Class Selector",
      "scope": [
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "CSS ID Selector",
      "scope": [
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffa060"
      }
    },
    {
      "name": "CSS Variable",
      "scope": [
        "variable.css",
        "variable.argument.css"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "Decorator/Annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffaa50"
      }
    },
    {
      "name": "Python - Decorator @",
      "scope": [
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#ffa060"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4a80ff"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#00c8e8"
      }
    },
    {
      "name": "JSON Key - Level 4+",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "Python - Docstring",
      "scope": [
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#4a6080"
      }
    },
    {
      "name": "JavaScript/TypeScript - Arrow Function",
      "scope": [
        "storage.type.function.arrow.js",
        "storage.type.function.arrow.ts",
        "storage.type.function.arrow.tsx"
      ],
      "settings": {
        "foreground": "#8878e8"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": [
        "markup.heading",
        "markup.heading.markdown"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffe088"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6080a0"
      }
    },
    {
      "name": "Markup - Link",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#4a80ff"
      }
    },
    {
      "name": "Markup - Code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#80e8c0"
      }
    },
    {
      "name": "Git - Inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#00c8e8"
      }
    },
    {
      "name": "Git - Deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#ff7070"
      }
    },
    {
      "name": "Git - Changed",
      "scope": [
        "markup.changed",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#ffe060"
      }
    }
  ]
}