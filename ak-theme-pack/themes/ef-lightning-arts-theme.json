        "constant.language.true",
        "constant.language.false",
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#a898ff"
      }
    },
    {
      "name": "builtin_constant — Other language/library constants (NaN, NULL, lib",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#60e0ff"
      }
    },
    {
      "name": "string_escape — Escapes (\\n), format placeholders (%d, {}), ${} ",
