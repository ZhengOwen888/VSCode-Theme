        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6a7588"
      }
    },
    {
      "name": "comment_doc — Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc",
        "comment.line.double-slash.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc",
        "storage.type.class.doxygen"
      ],
      "settings": {
        "foreground": "#6a7588",
        "fontStyle": "italic"
      }
    },
    {
      "name": "comment_todo — TODO / FIXME / NOTE tags inside comments (italic",
      "scope": [
        "comment keyword.codetag",
        "comment.line keyword",
        "comment.block keyword"
      ],
      "settings": {
        "foreground": "#7aaeff",
        "fontStyle": "italic"
      }
    },
    {
