    {
      "name": "attribute — HTML/XML attribute names, JSX props",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffb860"
      }
    },
    {
      "name": "css_property — CSS/SCSS/Less property names",
      "scope": [
        "support.type.property-name"
