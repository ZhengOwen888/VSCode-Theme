  "tokenColors": [
    {
      "name": "keyword — Declarations and modifiers",
      "scope": [
        "keyword",
        "keyword.other",
        "keyword.declaration",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeof",
        "keyword.operator.typeid",
        "keyword.operator.instanceof",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.cast",
        "keyword.control.at-rule",
        "punctuation.definition.keyword",
        "punctuation.definition.storage.type.objc"
      ],
      "settings": {
        "foreground": "#b8a5ff"
      }
    },
    {
      "name": "function — Function names (definitions and calls)",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#ffda5a"
      }
    },
    {
      "name": "string — String literals and their quotes",
      "scope": [
        "string",
        "punctuation.definition.string",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#c8e070"
      }
    },
    {
      "name": "number — Numeric literals and CSS units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d4a025"
      }
    },
    {
      "name": "type — Class/struct/enum/interface/trait/typedef names,",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.exception",
        "storage.class",
        "storage.type.java",
        "storage.type.object.array.java",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#e8dcc8"
      }
    },
    {
      "name": "comment — Comments (italic, muted)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a8598",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword_flow — Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8fa5ff"
      }
    },
    {
      "name": "keyword_special — import/export/include/using/use/package, async/a",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.using",
        "keyword.other.use",
        "keyword.other.namespace",
        "keyword.other.crate",
        "keyword.package",
        "keyword.import",
        "keyword.control.flow.async",
        "keyword.control.flow.await",
        "keyword.control.async",
        "keyword.control.await",
        "keyword.control.yield",
        "keyword.operator.await",
        "storage.modifier.async",
        "storage.type.function.async"
      ],
      "settings": {
        "foreground": "#8fa5ff"
      }
    },
    {
      "name": "type_builtin — Primitive/builtin types",
      "scope": [
        "storage.type.built-in",
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean",
        "storage.type.core",
        "storage.type.rune",
        "keyword.type",
        "support.type.primitive",
        "support.type.builtin",
        "support.type.python",
        "entity.name.type.primitive",
        "entity.name.type.numeric"
      ],
      "settings": {
        "foreground": "#b8a5ff"
      }
    },
    {
      "name": "variable_special — this / self / super / cls / arguments (neutral b",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#5d7aff"
      }
    },
    {
      "name": "macro — Preprocessor directives and macros",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.function.macro",
        "entity.name.other.preprocessor",
        "support.function.macro",
        "support.macro",
        "keyword.control.directive",
        "keyword.preprocessor",
        "punctuation.definition.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#ffda5a"
      }
    },
    {
      "name": "annotation — Decorators, annotations, attributes",
      "scope": [
        "meta.decorator",
        "meta.function.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.annotation",
        "entity.name.type.annotation",
        "meta.attribute.rust",
        "punctuation.brackets.attribute",
        "punctuation.definition.attribute.rust"
      ],
      "settings": {
        "foreground": "#ffda5a"
      }
    },
    {
      "name": "label — Rust lifetimes ('a), loop labels, goto labels",
      "scope": [
        "entity.name.label",
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "punctuation.definition.lifetime",
        "entity.name.lifetime",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#e8dcc8"
      }
    },
    {
      "name": "operator — Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#b8a5ff"
      }
    },
    {
      "name": "punctuation — Braces, parens, commas, semicolons, ",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8fa5ff"
      }
    },
    {
      "name": "method — Method names (member functions)",
      "scope": [
        "entity.name.function.member",
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "variable.function.member"
      ],
      "settings": {
        "foreground": "#ffda5a"
      }
    },
    {
      "name": "builtin_function — Library/builtin functions",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "support.function.kernel",
        "support.function.core",
        "support.function.std",
        "support.function.C99"
      ],
      "settings": {
        "foreground": "#ffda5a"
      }
    },
    {
      "name": "variable — Variables and plain identifiers (also sets edito",
      "scope": [
        "variable",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#e0f0f8"
      }
    },
    {
      "name": "parameter — Function parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#d4a025"
      }
    },
    {
      "name": "property — Fields, members, object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "variable.other.field",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.name.variable.property",
        "entity.name.variable.field",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#8fa5ff"
      }
    },
    {
      "name": "constant — User constants and enum members (MAX_SIZE, Color",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#e0f0f8"
      }
    },
    {
      "name": "type_param — Generic / template parameters (T, K, V)",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.template",
        "entity.name.type.generic",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#e8dcc8"
      }
    },
    {
      "name": "namespace — Namespaces, modules, packages, scope qualifiers ",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "entity.name.module",
        "entity.name.package",
        "entity.name.scope-resolution",
        "support.other.namespace",
        "support.other.module"
      ],
      "settings": {
        "foreground": "#8dc5ff"
      }
    },
    {
      "name": "import_path — Header and package paths in include/import",
      "scope": [
        "string.quoted.other.lt-gt.include",
        "string.quoted.double.include",
        "storage.modifier.import.java",
        "storage.modifier.package.java",
        "variable.language.wildcard.java"
      ],
      "settings": {
        "foreground": "#b8a5ff"
      }
    },
    {
      "name": "boolean_null — true / false / null / nil / None / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false",
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#d4a025"
      }
    },
    {
      "name": "builtin_constant — Other language/library constants (NaN, NULL, lib",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d4a025"
      }
    },
    {
      "name": "string_escape — Escapes (\\n), format placeholders (%d, {}), ${} ",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "constant.character.format",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#5d7aff"
      }
    },
    {
      "name": "regex — Regular-expression literals",
      "scope": [
        "string.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#95b840"
      }
    },
    {
      "name": "docstring — Python docstrings",
      "scope": [
        "string.quoted.docstring"
      ],
