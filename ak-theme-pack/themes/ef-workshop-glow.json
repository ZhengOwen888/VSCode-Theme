        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#987e99",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword_flow — Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ff9bd5"
      }
    },
    {
      "name": "keyword_special — import/export/include/using/use/package, async/a",
      "scope": [
