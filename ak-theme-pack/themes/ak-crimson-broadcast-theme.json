      "settings": {
        "foreground": "#a39a91"
      }
    },
    {
      "name": "punctuation — Braces, parens, commas, semicolons, ",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#a39a91"
      }
    },
    {
      "name": "method — Method names (member functions)",
      "scope": [
        "entity.name.function.member",
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "variable.function.member"
      ],
      "settings": {
        "foreground": "#9296ff"
      }
    },
    {
      "name": "builtin_function — Library/builtin functions",
