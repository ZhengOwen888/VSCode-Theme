        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#e9ddd0"
      }
    },
    {
      "name": "parameter — Function parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#f0b29d"
      }
    },
    {
      "name": "property — Fields, members, object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "variable.other.field",
        "meta.property.object",
        "meta.object-literal.key",
        "entity.name.variable.property",
        "entity.name.variable.field",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#e9ddd0"
      }
    },
    {
      "name": "constant — User constants and enum members (MAX_SIZE, Color",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#92d2fc"
      }
    },
    {
      "name": "type_param — Generic / template parameters (T, K, V)",
      "scope": [
        "entity.name.type.parameter",
        "entity.name.type.template",
        "entity.name.type.generic",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#50cde6"
      }
    },
    {
      "name": "namespace — Namespaces, modules, packages, scope qualifiers ",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "entity.name.module",
        "entity.name.package",
        "entity.name.scope-resolution",
