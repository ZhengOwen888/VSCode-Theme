        "entity.name.type.parameter",
        "entity.name.type.template",
        "entity.name.type.generic",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#c8b5ff"
      }
    },
    {
      "name": "namespace — Namespaces, modules, packages, scope qualifiers ",
