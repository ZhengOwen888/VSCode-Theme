      "settings": {
        "foreground": "#e8dcc8"
      }
    },
    {
      "name": "constant — User constants and enum members (MAX_SIZE, Color",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#b098d8"
      }
    },
    {
      "name": "type_param — Generic / template parameters (T, K, V)",
