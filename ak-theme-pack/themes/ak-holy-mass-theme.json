  "tokenColors": [
    {
      "name": "keyword — Declarations and modifiers",
      "scope": [
        "keyword",
        "keyword.other",
        "keyword.declaration",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeof",
        "keyword.operator.typeid",
        "keyword.operator.instanceof",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.cast",
        "keyword.control.at-rule",
        "punctuation.definition.keyword",
        "punctuation.definition.storage.type.objc"
      ],
      "settings": {
        "foreground": "#ff5566"
      }
    },
    {
      "name": "function — Function names (definitions and calls)",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e5b584"
      }
    },
    {
      "name": "string — String literals and their quotes",
      "scope": [
        "string",
        "punctuation.definition.string",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#ff99bb"
      }
    },
    {
      "name": "number — Numeric literals and CSS units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c8b5ff"
      }
    },
    {
      "name": "type — Class/struct/enum/interface/trait/typedef names,",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.exception",
        "storage.class",
        "storage.type.java",
        "storage.type.object.array.java",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7d9fcf"
      }
    },
    {
      "name": "comment — Comments (italic, muted)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a7b82",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword_flow — Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ff5566"
      }
    },
    {
      "name": "keyword_special — import/export/include/using/use/package, async/a",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.using",
        "keyword.other.use",
        "keyword.other.namespace",
        "keyword.other.crate",
        "keyword.package",
        "keyword.import",
        "keyword.control.flow.async",
        "keyword.control.flow.await",
        "keyword.control.async",
        "keyword.control.await",
        "keyword.control.yield",
        "keyword.operator.await",
        "storage.modifier.async",
        "storage.type.function.async"
      ],
      "settings": {
        "foreground": "#ff6677"
      }
    },
    {
      "name": "type_builtin — Primitive/builtin types",
      "scope": [
        "storage.type.built-in",
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean",
        "storage.type.core",
        "storage.type.rune",
        "keyword.type",
        "support.type.primitive",
        "support.type.builtin",
        "support.type.python",
        "entity.name.type.primitive",
        "entity.name.type.numeric"
      ],
      "settings": {
        "foreground": "#9876c4"
      }
    },
    {
      "name": "variable_special — this / self / super / cls / arguments (neutral b",
