    "editorWarning.foreground": "#b89870",
    "editorWhitespace.foreground": "#1a1f28",
    "editorWidget.background": "#0f1218",
    "editorWidget.border": "#5a6a80",
    "focusBorder": "#a8b8d0",
    "foreground": "#d8e0f0",
    "gitDecoration.addedResourceForeground": "#78a890",
    "gitDecoration.modifiedResourceForeground": "#5a8fff",
    "gitDecoration.deletedResourceForeground": "#d87878",
    "gitDecoration.untrackedResourceForeground": "#90a8c8",
    "gitDecoration.ignoredResourceForeground": "#3a4555",
    "input.background": "#15191f",
    "input.border": "#2a3545",
    "input.foreground": "#d8e0f0",
    "inputOption.activeBorder": "#a8b8d0",
    "inputOption.activeBackground": "#3a455540",
    "list.activeSelectionBackground": "#5a8fff40",
    "list.activeSelectionForeground": "#e8f0ff",
    "list.focusBackground": "#5a8fff30",
    "list.highlightForeground": "#7aaeff",
    "list.hoverBackground": "#1f232c80",
    "list.inactiveSelectionBackground": "#1f232c80",
    "menu.background": "#0f1218",
    "menu.foreground": "#d8e0f0",
    "menu.selectionBackground": "#5a8fff40",
    "menu.border": "#1a2030",
    "panel.background": "#15191f",
    "panel.border": "#1a2030",
    "panelTitle.activeBorder": "#5a8fff",
    "panelTitle.activeForeground": "#7aaeff",
    "panelTitle.inactiveForeground": "#5a6a80",
