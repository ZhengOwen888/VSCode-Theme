    "titleBar.activeForeground": "#d8e0f0",
    "titleBar.border": "#1a2030",
    "titleBar.inactiveBackground": "#15191f",
    "titleBar.inactiveForeground": "#5a6a80"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6a7588"
      }
    },
    {
      "name": "Comment - TODO/FIXME/NOTE",
      "scope": [
        "comment keyword.codetag",
        "comment.line keyword",
        "comment.block keyword"
      ],
      "settings": {
        "foreground": "#7aaeff"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#d8e0f0"
      }
    },
    {
      "name": "Variable - Special/Constant",
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#a898c8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d87878"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4a7fff"
      }
    },
    {
      "name": "Keyword - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await",
        "storage.modifier.async"
      ],
      "settings": {
        "foreground": "#5a8fff"
      }
    },
    {
      "name": "Keyword - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#ff9080"
      }
    },
    {
      "name": "Operator - Pointer/Reference (C/C++)",
      "scope": [
        "keyword.operator.address",
        "keyword.operator.dereference",
        "punctuation.separator.pointer-access"
      ],
      "settings": {
        "foreground": "#4a7fff"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.bracket", "meta.delimiter"],
      "settings": {
        "foreground": "#a0b0c8"
      }
    },
    {
      "name": "Punctuation - Namespace/Scope Separator",
      "scope": [
        "punctuation.separator.namespace",
        "punctuation.accessor",
        "punctuation.separator.scope-resolution"
      ],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "HTML/XML Tag Name",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffd080"
      }
    },
    {
      "name": "Function - Built-in/Magic",
      "scope": ["support.function.builtin", "support.function.magic"],
      "settings": {
        "foreground": "#ffb860"
      }
    },
    {
      "name": "Function - Console/Debug (print, console.log, printf)",
      "scope": [
        "support.function.console",
        "entity.name.function.call.console",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "Python - Print Function",
      "scope": ["support.function.builtin.python"],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "C/C++ - Preprocessor Directive",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "C/C++ - Preprocessor Include",
      "scope": ["keyword.control.include", "string.quoted.other.lt-gt.include"],
      "settings": {
        "foreground": "#ff90a0"
      }
    },
    {
      "name": "C/C++ - Macro",
      "scope": [
        "entity.name.function.preprocessor.c",
        "entity.name.function.preprocessor.cpp"
      ],
      "settings": {
        "foreground": "#d090ff"
      }
    },
    {
      "name": "C/C++ - Namespace",
      "scope": [
        "entity.name.namespace.cpp",
        "entity.name.scope-resolution.cpp"
      ],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "variable.parameter.function"],
      "settings": {
        "foreground": "#70e0ff"
      }
    },
    {
      "name": "Parameter - Special (self, this, cls)",
      "scope": [
        "variable.parameter.function.language.special",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ffa0e0"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#ffa870"
      }
    },
    {
      "name": "Constant - Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#ff8090"
      }
    },
    {
      "name": "Constant - Null/Undefined",
      "scope": ["constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#a070d8"
      }
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {
        "foreground": "#a0d0ff"
      }
    },
    {
      "name": "String - Template",
      "scope": ["string.template", "string.quoted.template"],
      "settings": {
        "foreground": "#b0e0ff"
      }
    },
    {
      "name": "String - Template Expression ${...}",
      "scope": [
        "meta.template.expression",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ffb860"
      }
    },
    {
      "name": "Python - f-string",
      "scope": [
        "string.quoted.single.python.f-string",
        "string.quoted.double.python.f-string"
      ],
      "settings": {
        "foreground": "#b0e0ff"
      }
    },
    {
      "name": "Python - f-string Expression {...}",
      "scope": ["meta.fstring.python", "punctuation.definition.interpolation"],
      "settings": {
        "foreground": "#ffb860"
      }
    },
    {
      "name": "String - Regexp",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#70d0a0"
      }
    },
    {
      "name": "Escape Characters",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#80c0ff"
      }
    },
    {
      "name": "Class - Inherited",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "foreground": "#90d0ff"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#60b0ff"
      }
    },
    {
      "name": "Type - Primitive",
      "scope": ["support.type.primitive"],
      "settings": {
        "foreground": "#a070d8"
      }
    },
    {
      "name": "Type - Built-in (C/C++)",
      "scope": ["storage.type.built-in", "storage.type.primitive"],
      "settings": {
        "foreground": "#a070d8"
      }
    },
    {
      "name": "Type Hint (Python)",
      "scope": [
        "meta.function.parameters.python support.type",
        "meta.function.return-type support.type"
      ],
      "settings": {
        "foreground": "#80c0ff"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "Type Parameter/Generics",
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#d090ff"
      }
    },
    {
      "name": "Namespace/Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "variable.other.readwrite.module"
      ],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#d8e0f0"
      }
    },
    {
      "name": "Property - Definition",
      "scope": ["entity.name.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#60b0ff"
      }
    },
    {
      "name": "Method - Class Member",
      "scope": ["entity.name.function.member", "meta.method.declaration"],
      "settings": {
        "foreground": "#ffd080"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ffb860"
      }
    },
    {
      "name": "Attribute - HTML",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#ffd080"
      }
    },
    {
      "name": "Attribute - ID",
      "scope": ["entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#ff9080"
      }
    },
    {
      "name": "Attribute - Class",
      "scope": ["entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name"
      ],
      "settings": {
        "foreground": "#60b0ff"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value.css", "constant.numeric.css"],
      "settings": {
        "foreground": "#ffa0e0"
      }
    },
    {
      "name": "CSS Class Selector",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "CSS ID Selector",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#ff9080"
      }
    },
    {
      "name": "CSS Variable",
      "scope": ["variable.css", "variable.argument.css"],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "Decorator/Annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffa870"
      }
    },
    {
      "name": "Python - Decorator @",
      "scope": ["punctuation.definition.decorator.python"],
      "settings": {
        "foreground": "#ff90a0"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4a7fff"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffd080"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#60d8ff"
      }
    },
    {
      "name": "JSON Key - Level 4+",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffa0e0"
      }
    },
    {
      "name": "Python - Docstring",
      "scope": ["string.quoted.docstring.multi.python"],
      "settings": {
        "foreground": "#6a7588"
      }
    },
    {
      "name": "JavaScript/TypeScript - Arrow Function",
      "scope": [
        "storage.type.function.arrow.js",
        "storage.type.function.arrow.ts",
        "storage.type.function.arrow.tsx"
      ],
      "settings": {
        "foreground": "#6a9fff"
      }
    },
    {
      "name": "Markup - Heading",
      "scope": ["markup.heading", "markup.heading.markdown"],
      "settings": {
        "foreground": "#4a7fff"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#ffd080"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#c080ff"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#9aa8b8"
      }
    },
    {
      "name": "Markup - Link",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": {
        "foreground": "#60b0ff"
      }
    },
    {
      "name": "Markup - Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#70d0a0"
      }
    },
    {
      "name": "Git - Inserted",
      "scope": ["markup.inserted", "markup.inserted.git_gutter"],
      "settings": {
        "foreground": "#60c090"
      }
    },
    {
      "name": "Git - Deleted",
      "scope": ["markup.deleted", "markup.deleted.git_gutter"],
      "settings": {
        "foreground": "#ff7070"
      }
    },
    {
      "name": "Git - Changed",
      "scope": ["markup.changed", "markup.changed.git_gutter"],
      "settings": {
        "foreground": "#4a7fff"
      }
    },
    {
      "name": "Python - Docstring",
      "scope": ["string.quoted.docstring.multi.python"],
      "settings": {
        "foreground": "#6a7588"
      }
    },
    {
      "name": "JavaScript/TypeScript - Arrow Function",
      "scope": [
        "storage.type.function.arrow.js",
        "storage.type.function.arrow.ts",
        "storage.type.function.arrow.tsx"
      ],
      "settings": {
        "foreground": "#7aaeff"
      }
    },
