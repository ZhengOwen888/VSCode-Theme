    "scrollbarSlider.background": "#3a455540",
    "scrollbarSlider.hoverBackground": "#4a556560",
    "scrollbarSlider.activeBackground": "#5a6a8080",
    "selection.background": "#5a8fff60",
    "sideBar.background": "#15191f",
    "sideBar.border": "#1a2030",
    "sideBar.foreground": "#d8e0f0",
    "sideBarSectionHeader.background": "#0f1218",
    "sideBarSectionHeader.foreground": "#d8e0f0",
    "sideBarSectionHeader.border": "#1a2030",
    "sideBarTitle.foreground": "#a8b8d0",
    "statusBar.background": "#0f1218",
    "statusBar.foreground": "#d8e0f0",
    "statusBar.border": "#1a2030",
    "statusBar.debuggingBackground": "#d87878",
    "statusBar.debuggingForeground": "#0a0d14",
    "statusBarItem.remoteBackground": "#5a8fff",
    "statusBarItem.remoteForeground": "#0a0d14",
    "tab.activeBackground": "#181c24",
    "tab.activeForeground": "#e8f0ff",
    "tab.activeBorder": "#5a8fff",
    "tab.activeBorderTop": "#a8b8d0",
    "tab.border": "#1a1f28",
    "tab.hoverBackground": "#1f232c80",
    "tab.inactiveBackground": "#15191f",
    "tab.inactiveForeground": "#5a6a80",
    "terminal.background": "#181c24",
    "terminal.foreground": "#d8e0f0",
    "terminal.ansiBlack": "#181c24",
    "terminal.ansiRed": "#d87878",
    "terminal.ansiGreen": "#78a890",
    "terminal.ansiYellow": "#a8b898",
    "terminal.ansiBlue": "#5a8fff",
    "terminal.ansiMagenta": "#90a8c8",
    "terminal.ansiCyan": "#78b8d8",
    "terminal.ansiWhite": "#d8e0f0",
    "terminal.ansiBrightBlack": "#2a3545",
    "terminal.ansiBrightRed": "#e89898",
    "terminal.ansiBrightGreen": "#88b8a0",
    "terminal.ansiBrightYellow": "#b8c8a8",
    "terminal.ansiBrightBlue": "#6a9fff",
    "terminal.ansiBrightMagenta": "#a0b8d8",
    "terminal.ansiBrightCyan": "#88c8e8",
    "terminal.ansiBrightWhite": "#e8f0ff",
    "terminal.selectionBackground": "#5a8fff40",
    "terminalCursor.foreground": "#7aaeff",
